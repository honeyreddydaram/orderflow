# Maven / Java
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# IDE
.idea/
*.iml
*.iws
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Env / secrets
.env
*.pem
*.key
# Exception: committed test-fixture keypairs (not real secrets - used only to sign JWTs in
# isolated test DBs), one per service under src/test/resources/keys/.
!*/src/test/resources/keys/*.pem

# Node / frontend (later)
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Testcontainers / Docker
docker/volumes/

# Generated JWT signing keys (see docker/generate-jwt-keys.sh) - never commit private keys
docker/secrets/
